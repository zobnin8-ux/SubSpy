# SubSpy environment variables

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (receipt parsing)
OPENAI_API_KEY=

# Resend (renewal alert emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=SubSpy <alerts@subspy.app>

# Polar (billing)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRO_PRODUCT_ID=
POLAR_SANDBOX=true

# Email intake (shared secret between Cloudflare Worker and API)
EMAIL_INTAKE_SECRET=

# Cron job auth (Vercel Cron sends Authorization header)
CRON_SECRET=

# Optional: Telegram bot for Pro alerts
TELEGRAM_BOT_TOKEN=

# Public: forwarding domain for user aliases
NEXT_PUBLIC_FORWARD_DOMAIN=in.subspy.app
